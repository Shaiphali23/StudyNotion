# Copy to .env.local and fill in real values (NEVER commit real secrets)
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<appName>"
JWT_SECRET=change-me-to-a-long-random-string
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

MAIL_HOST=smtp.gmail.com
MAIL_USER=you@example.com
MAIL_PASS=your-app-password-here

FOLDER_NAME="Ed-tech"
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxxxx

# Optional: override API base (defaults to /api/v1 same-origin)
NEXT_PUBLIC_BASE_URL=/api/v1
FRONTEND_URL=http://localhost:3000
